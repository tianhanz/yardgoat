{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "title": "Yardgoat control settings (other local config fields allowed)",
 "properties": {
  "sessions": {
   "type": "object",
   "properties": {
    "agents": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name"
      ],
      "anyOf": [
       {
        "required": [
         "exe"
        ]
       },
       {
        "required": [
         "comm"
        ]
       },
       {
        "required": [
         "argv0"
        ]
       }
      ],
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1
       },
       "exe": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/]+$"
       },
       "comm": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/]+$"
       },
       "argv0": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/]+$"
       }
      }
     }
    }
   }
  },
  "project_admins": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "reconcile_stale_min": {
   "type": "number",
   "exclusiveMinimum": 0,
   "default": 10
  },
  "notify": {
   "oneOf": [
    {
     "$ref": "#/$defs/notify_route"
    },
    {
     "type": "array",
     "items": {
      "$ref": "#/$defs/notify_route"
     }
    }
   ],
   "description": "Route names must be unique. Controller fields require a live controller for project-owned cards. Only endpoint requires a verified socket and pane_id; label/session routes work outside tmux. Endpoint is compact JSON; controller fields are empty for legacy cards."
  },
  "reclaim_dead": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
   },
   "description": "Projects allowed to reclaim a controller confirmed dead by local proc evidence"
  }
 },
 "$defs": {
  "notify_route": {
   "type": "object",
   "required": [
    "command"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "default": "default"
    },
    "recipient": {
     "type": "string",
     "description": "Destination dedupe template. Supported fields: task_id, status, owner, question, hint, controller, controller_session, endpoint. Use controller_session to resend after handoff."
    },
    "command": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     },
     "description": "Argv templates, no shell. Unknown placeholders disable this route until fixed."
    },
    "on": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
