{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Yardgoat event",
 "type": "object",
 "required": [
  "at",
  "task_id",
  "kind",
  "actor",
  "dedupe_key"
 ],
 "properties": {
  "at": {
   "type": "string"
  },
  "task_id": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "task.accepted",
    "task.owner_changed",
    "task.parked",
    "task.answered",
    "run.dispatched",
    "run.started",
    "run.exited",
    "run.lost",
    "run.verified",
    "run.launch_failed",
    "task.archived",
    "run.queued",
    "run.cancelled"
   ]
  },
  "actor": {
   "type": "string"
  },
  "dedupe_key": {
   "type": "string"
  }
 }
}