{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Yardgoat event",
 "type": "object",
 "required": [
  "at",
  "task_id",
  "kind",
  "actor",
  "dedupe_key"
 ],
 "properties": {
  "at": {
   "type": "string"
  },
  "task_id": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "task.accepted",
    "task.owner_changed",
    "task.parked",
    "task.answered",
    "run.dispatched",
    "run.started",
    "run.exited",
    "run.lost",
    "run.verified",
    "run.launch_failed",
    "task.archived",
    "run.queued",
    "run.cancelled",
    "run.claimed",
    "run.provider_refused",
    "run.waiting_deps",
    "run.scope_blocked"
   ]
  },
  "actor": {
   "type": "string"
  },
  "dedupe_key": {
   "type": "string"
  },
  "reason": {
   "type": "string",
   "description": "Scheduling blocker, upstream termination, or matching provider refusal log line, when applicable."
  },
  "waiting_for": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Unverified upstream task ids for run.waiting_deps."
  },
  "conflicts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "task_id",
     "path"
    ],
    "properties": {
     "task_id": {
      "type": "string"
     },
     "path": {
      "type": "string"
     }
    }
   },
   "description": "Conflicting tasks and absolute path prefixes for run.scope_blocked."
  }
 }
}
