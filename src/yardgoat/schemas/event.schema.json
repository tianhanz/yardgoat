{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Yardgoat event",
 "type": "object",
 "required": [
  "at",
  "task_id",
  "kind",
  "actor",
  "dedupe_key"
 ],
 "properties": {
  "at": {
   "type": "string"
  },
  "task_id": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "task.accepted",
    "task.owner_changed",
    "task.parked",
    "task.answered",
    "run.dispatched",
    "run.started",
    "run.exited",
    "run.lost",
    "run.verified",
    "run.launch_failed",
    "task.archived",
    "run.queued",
    "run.cancelled",
    "run.claimed",
    "run.provider_refused",
    "run.waiting_deps",
    "run.scope_blocked",
    "task.approved",
    "task.approval_invalidated",
    "task.on_pass_started",
    "task.on_pass_finished",
    "task.delivery_assumed_stopped",
    "task.review_processed",
    "task.review_channel_confirmed",
    "task.project_bound"
   ]
  },
  "actor": {
   "type": "string"
  },
  "dedupe_key": {
   "type": "string"
  },
  "reason": {
   "type": "string",
   "description": "Scheduling blocker, upstream termination, or matching provider refusal log line, when applicable."
  },
  "waiting_for": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Unverified upstream task ids for run.waiting_deps."
  },
  "conflicts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "task_id",
     "path"
    ],
    "properties": {
     "task_id": {
      "type": "string"
     },
     "path": {
      "type": "string"
     }
    }
   },
   "description": "Conflicting tasks and absolute path prefixes for run.scope_blocked."
  },
  "approval": {
   "type": "object",
   "required": [
    "by",
    "at",
    "content_hash",
    "note"
   ],
   "properties": {
    "by": {
     "type": "string"
    },
    "at": {
     "type": "string"
    },
    "content_hash": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "invalidated_at": {
     "type": "string"
    },
    "drift": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "name": {
   "type": "string"
  },
  "command": {
   "type": "string"
  },
  "cwd": {
   "type": "string"
  },
  "started_at": {
   "type": "string"
  },
  "finished_at": {
   "type": "string"
  },
  "output_tail": {
   "type": "string"
  },
  "step": {
   "type": "integer",
   "minimum": 1
  },
  "attempt": {
   "type": "integer",
   "minimum": 1
  },
  "exit_code": {
   "type": [
    "integer",
    "null"
   ]
  },
  "timed_out": {
   "type": "boolean"
  },
  "event_id": {
   "type": "string",
   "description": "Stable task/run/step/attempt identity for replayed delivery results."
  },
  "pgid": {
   "type": [
    "integer",
    "null"
   ]
  },
  "deadline": {
   "type": "number"
  },
  "interrupted": {
   "type": "boolean"
  },
  "process_identity": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "start_ticks": {
     "type": "string"
    },
    "boot_id": {
     "type": "string"
    }
   },
   "required": [
    "start_ticks",
    "boot_id"
   ]
  },
  "launch_protocol": {
   "type": "integer"
  },
  "write_set": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "assumed_stopped_by": {
   "type": "string"
  },
  "assumed_stopped_at": {
   "type": "string"
  },
  "assume_stopped": {
   "type": "boolean"
  },
  "review_task_id": {
   "type": "string"
  },
  "round": {
   "type": "integer",
   "minimum": 1
  },
  "findings_count": {
   "type": "integer",
   "minimum": 0
  },
  "blocking_count": {
   "type": "integer",
   "minimum": 0
  },
  "decision": {
   "enum": [
    "repair",
    "park",
    "pass",
    "pass_with_followups"
   ]
  },
  "owner_ref": {
   "type": "object",
   "required": [
    "project"
   ],
   "additionalProperties": false,
   "properties": {
    "project": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    }
   },
   "description": "Stable project controller role; handoff never rewrites cards."
  },
  "actor_session": {
   "type": "string",
   "pattern": "^s-[0-9a-f]{64}$",
   "description": "Mechanically identified manual controller."
  },
  "epoch": {
   "type": "integer",
   "minimum": 0
  },
  "on_behalf_of": {
   "type": "object",
   "required": [
    "project",
    "epoch"
   ],
   "additionalProperties": false,
   "properties": {
    "project": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "epoch": {
     "type": "integer",
     "minimum": 0
    }
   },
   "description": "System executor's project/term; actor is reconciler, without an impersonated actor_session."
  },
  "execution_control": {
   "type": "object",
   "description": "Original delivery execution grant (session/epoch or system on_behalf_of) preserved separately from the system recovery actor.",
   "properties": {
    "actor_session": {
     "type": "string",
     "pattern": "^s-[0-9a-f]{64}$",
     "description": "Mechanically identified manual controller."
    },
    "epoch": {
     "type": "integer",
     "minimum": 0
    },
    "on_behalf_of": {
     "type": "object",
     "required": [
      "project",
      "epoch"
     ],
     "additionalProperties": false,
     "properties": {
      "project": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
      },
      "epoch": {
       "type": "integer",
       "minimum": 0
      }
     },
     "description": "System executor's project/term; actor is reconciler, without an impersonated actor_session."
    }
   }
  },
  "replayed_by": {
   "type": "object",
   "description": "Caller that recovered a frozen review confirmation; the event itself retains the original confirmer identity.",
   "properties": {
    "actor": {
     "type": "string"
    },
    "actor_session": {
     "type": "string",
     "pattern": "^s-[0-9a-f]{64}$",
     "description": "Mechanically identified manual controller."
    },
    "epoch": {
     "type": "integer",
     "minimum": 0
    },
    "on_behalf_of": {
     "type": "object",
     "required": [
      "project",
      "epoch"
     ],
     "additionalProperties": false,
     "properties": {
      "project": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
      },
      "epoch": {
       "type": "integer",
       "minimum": 0
      }
     },
     "description": "System executor's project/term; actor is reconciler, without an impersonated actor_session."
    }
   }
  }
 }
}
