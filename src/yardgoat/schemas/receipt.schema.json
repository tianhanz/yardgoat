{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Yardgoat receipt",
 "type": "object",
 "required": [
  "task_id",
  "run_id",
  "attempt",
  "exit_code",
  "host",
  "actual_model",
  "artifacts",
  "finished_at",
  "status"
 ],
 "properties": {
  "task_id": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "project": {
   "type": "string"
  },
  "attempt": {
   "type": "integer"
  },
  "exit_code": {
   "type": [
    "integer",
    "null"
   ]
  },
  "timed_out": {
   "type": "boolean"
  },
  "host": {
   "type": "string"
  },
  "lane": {
   "type": "string"
  },
  "account_alias": {
   "type": "string"
  },
  "actual_model": {
   "type": "string"
  },
  "model_source": {
   "type": "string"
  },
  "cost_basis": {
   "type": "string"
  },
  "artifacts": {
   "type": "object",
   "additionalProperties": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "finished_at": {
   "type": "string"
  },
  "status": {
   "enum": [
    "exited",
    "blocked",
    "lost",
    "passed",
    "failed",
    "verifier_error",
    "launch_failed",
    "provider_refused"
   ]
  },
  "verifier": {
   "type": "object",
   "properties": {
    "command": {
     "type": "string"
    },
    "exit_code": {
     "type": "integer"
    },
    "result": {
     "enum": [
      "PASS",
      "FAIL",
      "ERROR"
     ]
    },
    "checked_at": {
     "type": "string"
    },
    "checked_by": {
     "type": "string"
    }
   }
  },
  "adapter": {
   "type": "string"
  },
  "worker": {
   "type": [
    "string",
    "null"
   ]
  },
  "question": {
   "type": "string"
  },
  "reason": {
   "type": "string"
  },
  "approval": {
   "type": "object",
   "required": [
    "by",
    "at",
    "content_hash",
    "note"
   ],
   "properties": {
    "by": {
     "type": "string"
    },
    "at": {
     "type": "string"
    },
    "content_hash": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "invalidated_at": {
     "type": "string"
    },
    "drift": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "on_pass": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "step",
     "name",
     "command",
     "cwd",
     "by",
     "attempt",
     "started_at",
     "exit_code",
     "output_tail",
     "timed_out"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "command": {
      "type": "string"
     },
     "cwd": {
      "type": "string"
     },
     "by": {
      "type": "string"
     },
     "started_at": {
      "type": "string"
     },
     "finished_at": {
      "type": "string"
     },
     "output_tail": {
      "type": "string"
     },
     "step": {
      "type": "integer",
      "minimum": 1
     },
     "attempt": {
      "type": "integer",
      "minimum": 1
     },
     "exit_code": {
      "type": [
       "integer",
       "null"
      ]
     },
     "timed_out": {
      "type": "boolean"
     },
     "pgid": {
      "type": [
       "integer",
       "null"
      ]
     },
     "deadline": {
      "type": "number"
     },
     "interrupted": {
      "type": "boolean"
     }
    }
   },
   "description": "Latest attempt per step, in execution order; successful steps are never rerun. Events retain retry history."
  },
  "delivery_failed": {
   "type": "boolean",
   "description": "Delivery needs retry; verification and receipt.status remain PASS/passed."
  },
  "delivery_pending": {
   "type": "boolean",
   "description": "PASS with declared delivery steps still unfinished."
  },
  "delivery_reason": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
