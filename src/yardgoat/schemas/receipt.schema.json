{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Yardgoat receipt",
 "type": "object",
 "required": [
  "task_id",
  "run_id",
  "attempt",
  "exit_code",
  "host",
  "actual_model",
  "artifacts",
  "finished_at",
  "status"
 ],
 "properties": {
  "task_id": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "project": {
   "type": "string"
  },
  "attempt": {
   "type": "integer"
  },
  "exit_code": {
   "type": [
    "integer",
    "null"
   ]
  },
  "timed_out": {
   "type": "boolean"
  },
  "host": {
   "type": "string"
  },
  "lane": {
   "type": "string"
  },
  "account_alias": {
   "type": "string"
  },
  "actual_model": {
   "type": "string"
  },
  "model_source": {
   "type": "string"
  },
  "cost_basis": {
   "type": "string"
  },
  "artifacts": {
   "type": "object",
   "additionalProperties": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "finished_at": {
   "type": "string"
  },
  "status": {
   "enum": [
    "exited",
    "blocked",
    "lost",
    "passed",
    "failed",
    "verifier_error",
    "launch_failed",
    "provider_refused",
    "reviewing",
    "reviewed"
   ]
  },
  "verifier": {
   "type": "object",
   "properties": {
    "command": {
     "type": "string"
    },
    "exit_code": {
     "type": "integer"
    },
    "result": {
     "enum": [
      "PASS",
      "FAIL",
      "ERROR"
     ]
    },
    "checked_at": {
     "type": "string"
    },
    "checked_by": {
     "type": "string"
    }
   }
  },
  "adapter": {
   "type": "string"
  },
  "worker": {
   "type": [
    "string",
    "null"
   ]
  },
  "question": {
   "type": "string"
  },
  "reason": {
   "type": "string"
  },
  "approval": {
   "type": "object",
   "required": [
    "by",
    "at",
    "content_hash",
    "note"
   ],
   "properties": {
    "by": {
     "type": "string"
    },
    "at": {
     "type": "string"
    },
    "content_hash": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "invalidated_at": {
     "type": "string"
    },
    "drift": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "on_pass": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "step",
     "name",
     "command",
     "cwd",
     "by",
     "attempt",
     "started_at",
     "exit_code",
     "output_tail",
     "timed_out"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "command": {
      "type": "string"
     },
     "cwd": {
      "type": "string"
     },
     "by": {
      "type": "string"
     },
     "started_at": {
      "type": "string"
     },
     "finished_at": {
      "type": "string"
     },
     "output_tail": {
      "type": "string"
     },
     "step": {
      "type": "integer",
      "minimum": 1
     },
     "attempt": {
      "type": "integer",
      "minimum": 1
     },
     "exit_code": {
      "type": [
       "integer",
       "null"
      ]
     },
     "timed_out": {
      "type": "boolean"
     },
     "pgid": {
      "type": [
       "integer",
       "null"
      ]
     },
     "deadline": {
      "type": "number"
     },
     "interrupted": {
      "type": "boolean"
     },
     "process_identity": {
      "type": [
       "object",
       "null"
      ],
      "properties": {
       "start_ticks": {
        "type": "string"
       },
       "boot_id": {
        "type": "string"
       }
      },
      "required": [
       "start_ticks",
       "boot_id"
      ]
     },
     "launch_protocol": {
      "type": "integer"
     },
     "write_set": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "assumed_stopped_by": {
      "type": "string"
     },
     "assumed_stopped_at": {
      "type": "string"
     }
    }
   },
   "description": "Latest attempt per step, in execution order; successful steps are never rerun. Events retain retry history."
  },
  "delivery_failed": {
   "type": "boolean",
   "description": "Delivery needs retry; verification and receipt.status remain PASS/passed."
  },
  "delivery_pending": {
   "type": "boolean",
   "description": "PASS with declared delivery steps still unfinished."
  },
  "delivery_reason": {
   "type": [
    "string",
    "null"
   ]
  },
  "review": {
   "type": "object",
   "required": [
    "rounds",
    "complete"
   ],
   "properties": {
    "rounds": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "round",
       "task_id",
       "run_id",
       "status",
       "findings_count"
      ],
      "properties": {
       "round": {
        "type": "integer",
        "minimum": 1
       },
       "task_id": {
        "type": "string"
       },
       "run_id": {
        "type": "string"
       },
       "status": {
        "enum": [
         "pending",
         "processed"
        ]
       },
       "findings_count": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "blocking_count": {
        "type": "integer",
        "minimum": 0
       },
       "findings": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "id",
          "severity",
          "file",
          "line",
          "title",
          "scenario",
          "fix"
         ],
         "properties": {
          "id": {
           "type": "string",
           "minLength": 1,
           "pattern": "\\S"
          },
          "file": {
           "type": "string",
           "minLength": 1,
           "pattern": "\\S"
          },
          "title": {
           "type": "string",
           "minLength": 1,
           "pattern": "\\S"
          },
          "scenario": {
           "type": "string",
           "minLength": 1,
           "pattern": "\\S"
          },
          "fix": {
           "type": "string",
           "minLength": 1,
           "pattern": "\\S"
          },
          "severity": {
           "enum": [
            "blocker",
            "major",
            "minor",
            "info"
           ]
          },
          "line": {
           "type": "integer",
           "minimum": 1
          }
         }
        }
       },
       "decision": {
        "enum": [
         "repair",
         "park",
         "pass",
         "pass_with_followups"
        ]
       },
       "followups": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "review_run_id": {
        "type": "string"
       }
      }
     }
    },
    "complete": {
     "type": "boolean"
    },
    "outcome": {
     "enum": [
      "park",
      "pass",
      "pass_with_followups"
     ]
    }
   }
  },
  "review_round": {
   "type": "integer",
   "minimum": 1
  },
  "review_of": {
   "type": "object",
   "required": [
    "task_id",
    "round"
   ],
   "properties": {
    "task_id": {
     "type": "string"
    },
    "round": {
     "type": "integer",
     "minimum": 1
    },
    "run_id": {
     "type": "string"
    }
   }
  },
  "review_findings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "severity",
     "file",
     "line",
     "title",
     "scenario",
     "fix"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "file": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "scenario": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "fix": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "severity": {
      "enum": [
       "blocker",
       "major",
       "minor",
       "info"
      ]
     },
     "line": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "findings_count": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0
  }
 }
}
