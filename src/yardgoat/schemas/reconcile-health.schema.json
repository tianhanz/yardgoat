{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "title": "Yardgoat reconcile health (observability only)",
 "required": [
  "last_started_at",
  "last_finished_at",
  "last_success_at",
  "errors"
 ],
 "properties": {
  "last_started_at": {
   "type": [
    "string",
    "null"
   ]
  },
  "last_finished_at": {
   "type": [
    "string",
    "null"
   ]
  },
  "last_success_at": {
   "type": [
    "string",
    "null"
   ]
  },
  "errors": {
   "type": "object",
   "required": [
    "count",
    "first"
   ],
   "properties": {
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "first": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "string",
      "maxLength": 1000
     }
    }
   }
  }
 }
}
